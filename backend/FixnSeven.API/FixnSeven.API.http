Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "equipmentId": "{{equipos.response.body.$.items[0].id}}",
  "technicianId": "{{tecnicos.response.body.$.items[0].id}}",
  "reportedIssue": "No carga la batería",
  "receivedCondition": "Pantalla con un rayón, sin cargador"
}

