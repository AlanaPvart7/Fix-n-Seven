  "validityDays": 60,
  "gradeScale": [
    { "grade": "Excelente", "minScore": 95, "maxScore": 100 },
    { "grade": "Bueno",     "minScore": 85, "maxScore": 94 },
    { "grade": "Regular",   "minScore": 60, "maxScore": 79 },
    { "grade": "Reprobado", "minScore": 0,  "maxScore": 59 }
  ]
}

