Authorization: Bearer {{rAdmin.response.body.token}}

### R13. Ver un recordatorio (200)
GET {{api}}/reminders/{{recordatorio.response.body.id}}
Authorization: Bearer {{rAdmin.response.body.token}}

### R14. El tecnico no ve recordatorios (403)
GET {{api}}/reminders/upcoming
Authorization: Bearer {{rTec.response.body.token}}

### R15. Otra empresa pide el recordatorio (404)
GET {{api}}/reminders/{{recordatorio.response.body.id}}
Authorization: Bearer {{rOtra.response.body.token}}

### R16. Borrar: ya se llamo al cliente (204)
DELETE {{api}}/reminders/{{recordatorio.response.body.id}}
Authorization: Bearer {{rAdmin.response.body.token}}

### R17. Borrar otra vez (404)
DELETE {{api}}/reminders/{{recordatorio.response.body.id}}
Authorization: Bearer {{rAdmin.response.body.token}}

### R18. Limpieza: borrar el de horas (204)
DELETE {{api}}/reminders/{{recordatorioHoras.response.body.id}}
Authorization: Bearer {{rAdmin.response.body.token}}

